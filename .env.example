# ------------------------------------------------------------
# PetHotel ortam değişkenleri
# Yerelde hiçbirini doldurmak zorunda değilsin: DATABASE_URL boşsa
# proje gömülü Postgres (PGlite) ile .data/ klasöründe çalışır.
# ------------------------------------------------------------

# Postgres bağlantı adresi (Neon, Supabase, Railway vb.)
# Vercel'de Neon entegrasyonunu bağlayınca otomatik eklenir.
DATABASE_URL=

# Oturum çerezlerini imzalamak için gizli anahtar (en az 32 karakter). İsteğe bağlı:
# boşsa yerelde geliştirme anahtarı, canlı veritabanında ise ilk açılışta üretilip
# veritabanında saklanan rastgele bir anahtar kullanılır.
# Kendin üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Platform yöneticisi (süper admin) hesabı. İlk çalıştırmada bu bilgilerle oluşturulur.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Canlı veritabanı boşsa demo klinikleri yüklemek için true yap (yerelde otomatik yüklenir).
SEED_DEMO_DATA=false

# Sitenin tam adresi (paylaşım bağlantıları için), örn. https://pethotel.com
# Boşsa Vercel'deki üretim adresi, o da yoksa http://localhost:3000 kullanılır.
NEXT_PUBLIC_SITE_URL=
